# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-REPLACE_ME

# ID чата/менеджера, куда падают заявки (личный chat_id, группа или канал).
# Узнать свой id можно у @userinfobot. Для группы добавьте бота в группу.
MANAGER_CHAT_ID=000000000

# Промокод на первый заказ
PROMO_CODE=ПЕРВЫЙ15

# Контакты (показываются в боте)
PHONE=8 (495) 000-00-00
CHANNEL=@KlinGroup
WORK_HOURS=8:00–22:00

# Через сколько секунд напомнить о брошенной заявке (по умолчанию 2 часа)
REMINDER_DELAY=7200
